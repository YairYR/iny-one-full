{
  "servers": {
    "supabase-local": {
      "type": "http",
      "url": "http://192.168.100.10:54321/mcp?read_only=true&features=docs%2Cdatabase%2Cdebugging%2Cdevelopment"
    },
    "iny-memory": {
      "type": "http",
      "url": "http://192.168.100.10:8888/mcp"
    },
